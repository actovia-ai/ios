    "ios:settings.error.notLoaded" : {
      "comment" : "Error shown when saving is attempted before the server's settings were loaded.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinden Sie sich mit dem Server und laden Sie dessen Einstellungen, bevor Sie speichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect to the server and load its settings before saving."
          }
