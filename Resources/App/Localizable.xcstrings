    "ios:health.noData.explain" : {
      "comment" : "Health home: why there is no data, and where Health access is turned on (Settings path names as each language shows them).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier ist noch nichts. Für Schlaf braucht es eine Apple Watch oder den Schlafmodus. Falls du den Health-Zugriff abgelehnt hast, schalte ihn in Einstellungen › Datenschutz & Sicherheit › Health › Actovia ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing here yet. Sleep needs an Apple Watch or a Sleep Focus. If you declined Health access, turn it on in Settings › Privacy & Security › Health › Actovia."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay nada. El sueño necesita un Apple Watch o el modo Sueño. Si rechazaste el acceso a Salud, actívalo en Ajustes › Privacidad y seguridad › Salud › Actovia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien pour l'instant. Le sommeil nécessite une Apple Watch ou le mode Sommeil. Si tu as refusé l'accès à Santé, active-le dans Réglages › Confidentialité et sécurité › Santé › Actovia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora niente. Il sonno richiede un Apple Watch o la modalità Sonno. Se hai rifiutato l'accesso a Salute, attivalo in Impostazioni › Privacy e sicurezza › Salute › Actovia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだデータがありません。睡眠には Apple Watch か睡眠集中モードが必要です。ヘルスケアへのアクセスを許可しなかった場合は、「設定 › プライバシーとセキュリティ › ヘルスケア › Actovia」でオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 데이터가 없어요. 수면 기록에는 Apple Watch나 수면 집중 모드가 필요해요. 건강 접근을 거부했다면 설정 › 개인정보 보호 및 보안 › 건강 › Actovia에서 켜 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há nada. O sono precisa de um Apple Watch ou do foco Sono. Se você recusou o acesso ao Saúde, ative em Ajustes › Privacidade e Segurança › Saúde › Actovia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь пока пусто. Для данных о сне нужны Apple Watch или режим фокусирования «Сон». Если вы запретили доступ к Здоровью, включите его в разделе «Настройки» › «Конфиденциальность и безопасность» › «Здоровье» › Actovia."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呢度仲未有資料。睡眠要 Apple Watch 或者睡眠專注模式。如果你拒絕咗健康 App 嘅權限，可以喺「設定 › 私隱與保安 › 健康 › Actovia」開返。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里还没有数据。睡眠数据需要 Apple Watch 或睡眠专注模式。如果你拒绝了健康访问权限，请前往“设置 › 隐私与安全性 › 健康 › Actovia”开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這裡還沒有資料。睡眠需要 Apple Watch 或睡眠專注模式。如果你拒絕了健康 App 的取用權限，請到「設定 › 隱私權與安全性 › 健康 › Actovia」開啟。"
          }
        }
      }
    },
