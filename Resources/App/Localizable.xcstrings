    "philharmonic:workforce.emptyState.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Mitarbeiter gehört zu einem Team, das einen gemeinsamen System-Prompt beisteuert. Erstellen Sie zuerst ein Team und fügen Sie dann die zugehörigen Mitarbeiter hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every employee belongs to a team that contributes a shared system prompt. Create a team first, then add the employees that belong to it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo empleado pertenece a un equipo que aporta un prompt de sistema compartido. Cree primero un equipo y luego agregue los empleados que pertenecen a él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque employé appartient à une équipe qui fournit un prompt système partagé. Créez d'abord une équipe, puis ajoutez les employés qui en font partie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni dipendente appartiene a un team che fornisce un prompt di sistema condiviso. Crea prima un team, poi aggiungi i dipendenti che ne fanno parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての従業員は、共通のシステムプロンプトを提供するチームに所属します。まずチームを作成し、それに属する従業員を追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 직원은 공통 시스템 프롬프트를 제공하는 팀에 소속됩니다. 먼저 팀을 만든 다음, 그 팀에 속할 직원을 추가하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo funcionário pertence a uma equipe que contribui com um prompt de sistema compartilhado. Crie uma equipe primeiro e depois adicione os funcionários que pertencem a ela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый сотрудник состоит в команде, которая задаёт общий системный промпт. Сначала создайте команду, затем добавьте в неё сотрудников."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每位員工都隸屬於一個提供共用系統提示詞的團隊。請先建立團隊，再新增所屬員工。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每位员工都属于一个提供共享系统提示词的团队。请先创建团队，再添加其中的员工。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每位員工都隸屬於一個提供共用系統提示詞的團隊。請先建立團隊，再新增所屬員工。"
          }
        }
      }
    },
