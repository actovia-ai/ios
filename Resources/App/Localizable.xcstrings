    "ios:settings.pairing.unreachable" : {
      "comment" : "Error: none of the computer's addresses answered while pairing.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Computer ist nicht erreichbar. Stellen Sie sicher, dass sich beide Geräte im selben Netzwerk befinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not reach your computer. Make sure both devices are on the same network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido conectar con tu ordenador. Comprueba que ambos dispositivos están en la misma red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre votre ordinateur. Vérifiez que les deux appareils sont sur le même réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere il tuo computer. Assicurati che entrambi i dispositivi siano sulla stessa rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータに接続できませんでした。両方のデバイスが同じネットワーク上にあることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터에 연결할 수 없습니다. 두 기기가 같은 네트워크에 있는지 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível alcançar o seu computador. Verifique se os dois dispositivos estão na mesma rede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось связаться с компьютером. Убедитесь, что оба устройства в одной сети."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連接到你的電腦。請確認兩部裝置在同一個網絡上。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接到你的电脑。请确认两台设备在同一网络中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連線到你的電腦。請確認兩部裝置在同一個網路上。"
          }
        }
      }
    },
    "ios:settings.personality.appliesToComputer" : {
      "comment" : "Footer at the end of the Personality settings page.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Persönlichkeit wird auf Ihrem Computer gespeichert und prägt jeden Chat, auf diesem Telefon wie auf dem Desktop."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personality is saved on your computer and shapes every chat, on this phone and on the desktop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La personalidad se guarda en tu ordenador y se aplica a todos los chats, en este teléfono y en el escritorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La personnalité est enregistrée sur votre ordinateur et s'applique à chaque conversation, sur ce téléphone comme sur l'ordinateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La personalità è salvata sul tuo computer e si applica a ogni chat, su questo telefono e sul desktop."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パーソナリティはコンピュータに保存され、このスマートフォンでもデスクトップでも、すべてのチャットに反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개성 설정은 컴퓨터에 저장되며 이 휴대폰과 데스크톱의 모든 채팅에 적용됩니다."
