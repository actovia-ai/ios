    "settings:memory.settings.useInChat.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezieht beim Antworten die Erinnerungen ein, die zu deiner Nachricht passen."
