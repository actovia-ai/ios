    "ios:settings.pairing.unpairedThereMessage" : {
      "comment" : "Settings → Computer, after checking each paired computer. %@ is the computer's name (or several, joined).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat dieses iPhone aus seinen Geräten entfernt, daher wurde die Kopplung auch hier aufgehoben. Um es wieder zu nutzen, kopple es über Einstellungen → Geräte dort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ removed this iPhone from its devices, so it was unpaired here too. To use it again, pair from its Settings → Devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ quitó este iPhone de sus dispositivos, así que también se desvinculó aquí. Para volver a usarlo, vincúlalo desde Ajustes → Dispositivos allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a retiré cet iPhone de ses appareils, il a donc aussi été dissocié ici. Pour l’utiliser à nouveau, associez-le depuis Réglages → Appareils sur l’ordinateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha rimosso questo iPhone dai suoi dispositivi, quindi l'abbinamento è stato annullato anche qui. Per usarlo di nuovo, abbinalo da Impostazioni → Dispositivi sul computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ がこの iPhone をデバイスから削除したため、こちらでもペアリングを解除しました。再び使うには、そのコンピュータの設定 → デバイスからペアリングしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 이 iPhone을 기기 목록에서 제거하여 여기서도 페어링을 해제했습니다. 다시 사용하려면 해당 컴퓨터의 설정 → 기기에서 페어링하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ removeu este iPhone dos dispositivos, então ele também foi despareado aqui. Para usá-lo de novo, pareie em Ajustes → Dispositivos no computador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ удалил этот iPhone из своих устройств, поэтому сопряжение разорвано и здесь. Чтобы снова пользоваться им, выполните сопряжение в его «Настройки → Устройства»."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已將這部 iPhone 從裝置中移除，所以這裡也已取消配對。如要再次使用，請在該電腦的「設定 → 裝置」重新配對。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已将这台 iPhone 从其设备中移除，因此这里也已取消配对。如需再次使用，请在该电脑的“设置 → 设备”中重新配对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已將這台 iPhone 從裝置中移除，所以這裡也已取消配對。若要再次使用，請在該電腦的「設定 → 裝置」重新配對。"
          }
        }
      }
    },
