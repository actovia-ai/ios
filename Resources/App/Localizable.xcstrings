    "settings:tools.registry.recall.description" : {
      "comment" : "Description of the Recall built-in tool in Settings → Built-in Tools.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lässt den Assistenten ein früheres Suchergebnis oder eine Werkzeugausgabe, die ältere Runden nur noch gekürzt enthalten, vollständig nachlesen – aus dem Gespeicherten, ohne erneut zu suchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets the assistant read back, in full, an earlier search result or tool output that older turns now carry only in short — from what is stored, without searching again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que el asistente vuelva a leer completo un resultado de búsqueda o la salida de una herramienta que los turnos anteriores ya solo llevan resumidos, a partir de lo guardado y sin volver a buscar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à l'assistant de relire en entier un résultat de recherche ou la sortie d'un outil que les tours précédents ne contiennent plus qu'en bref — depuis ce qui est enregistré, sans relancer de recherche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consente all'assistente di rileggere per intero un risultato di ricerca o l'output di uno strumento che i turni precedenti riportano ormai solo in breve, da quanto salvato e senza cercare di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前のターンでは要約だけになった検索結果やツールの出力を、保存済みの内容から全文で読み直せるようにします。再検索はしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 턴에는 요약만 남은 검색 결과나 도구 출력을 저장된 내용에서 전체로 다시 읽을 수 있게 합니다. 다시 검색하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que o assistente releia por completo um resultado de busca ou a saída de uma ferramenta que as rodadas anteriores agora trazem apenas resumidos — a partir do que foi salvo, sem buscar de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволяет ассистенту полностью перечитать прежний результат поиска или вывод инструмента, который в старых ходах сохранён лишь кратко, — из сохранённых данных, без повторного поиска."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓助理從已儲存的內容完整讀回較早回合中只剩摘要的搜尋結果或工具輸出，無須重新搜尋。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让助手从已保存的内容中完整读回较早轮次里只剩摘要的搜索结果或工具输出，无需重新搜索。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓助理從已儲存的內容完整讀回較早回合中只剩摘要的搜尋結果或工具輸出，無須重新搜尋。"
          }
        }
      }
    },
