    "ios:settings.backup.onComputer" : {
      "comment" : "Footer of the Backups section.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicherungen werden auf Ihrem Computer erstellt und dort aufbewahrt. Tägliche Sicherungen schalten Sie dort ein oder aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups are made and kept on your computer. Switch daily backups on or off there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias de seguridad se crean y se guardan en tu ordenador. Activa o desactiva allí las copias diarias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes sont créées et conservées sur votre ordinateur. Activez ou désactivez-y les sauvegardes quotidiennes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I backup vengono creati e conservati sul tuo computer. Attiva o disattiva lì i backup giornalieri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップはコンピュータ上で作成・保存されます。毎日のバックアップのオン/オフもコンピュータで切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업은 컴퓨터에서 만들어지고 보관됩니다. 매일 백업을 켜거나 끄는 것도 컴퓨터에서 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os backups são feitos e guardados no seu computador. Ative ou desative lá os backups diários."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервные копии создаются и хранятся на компьютере. Ежедневное копирование включается и выключается там."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備份會在你的電腦上建立並保存。每日備份亦請在電腦上開啟或關閉。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份在你的电脑上创建和保存。请在电脑上开启或关闭每日备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備份會在你的電腦上建立並保存。每日備份也請在電腦上開啟或關閉。"
          }
        }
      }
    },
