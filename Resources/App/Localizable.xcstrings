    "settings:dataControls.autoBackup.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichert Ihre Daten täglich um 3:00 Uhr. Backups werden lokal unter ~/.actovia/backups/ gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back up your data daily at 3:00 AM. Backups are stored locally in ~/.actovia/backups/."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haga una copia de seguridad de sus datos todos los días a las 3:00 a. m. Las copias se guardan localmente en ~/.actovia/backups/."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegardez vos données quotidiennement à 3h00. Les sauvegardes sont stockées localement dans ~/.actovia/backups/."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegue il backup dei tuoi dati ogni giorno alle 3:00. I backup vengono salvati localmente in ~/.actovia/backups/."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日午前3:00にデータをバックアップします。バックアップは~/.actovia/backups/にローカル保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일 오전 3시에 데이터를 백업합니다. 백업은 ~/.actovia/backups/에 로컬로 저장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça backup dos seus dados diariamente às 3h. Os backups são armazenados localmente em ~/.actovia/backups/."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ежедневное резервное копирование данных в 3:00. Копии хранятся локально в ~/.actovia/backups/."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天凌晨 3:00 備份你的資料，備份會儲存在本機的 ~/.actovia/backups/。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天凌晨 3:00 备份你的数据。备份保存在本地的 ~/.actovia/backups/。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天凌晨 3:00 備份你的資料。備份會儲存於本機的 ~/.actovia/backups/。"
          }
        }
      }
    },
