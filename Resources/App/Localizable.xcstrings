          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte-se ao servidor e carregue as configurações dele antes de salvar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед сохранением подключитесь к серверу и загрузите его настройки."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
