    "settings:memory.settings.contextWindowPercent.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginnt mit dem Zusammenfassen, wenn eine Unterhaltung diesen Anteil des Kontextfensters des Modells füllt (50–95 %). Standard: 75 %."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start summarizing when a conversation fills this much of the model's context window (50–95%). Default: 75%."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza a resumir cuando una conversación ocupa este porcentaje de la ventana de contexto del modelo (50–95 %). Predeterminado: 75 %."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commence à résumer quand une conversation remplit cette part de la fenêtre de contexte du modèle (50–95 %). Par défaut : 75 %."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia a riassumere quando una conversazione occupa questa parte della finestra di contesto del modello (50–95%). Predefinito: 75%."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会話がモデルのコンテキストウィンドウのこの割合に達したら要約を始めます（50〜95%）。既定値：75%。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화가 모델 컨텍스트 창의 이 비율을 채우면 요약을 시작합니다(50–95%). 기본값: 75%."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Começa a resumir quando uma conversa ocupa esta parte da janela de contexto do modelo (50–95%). Padrão: 75%."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начинать сжатие, когда разговор заполняет такую долю контекстного окна модели (50–95%). По умолчанию: 75%."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當對話佔用模型情境視窗的這個比例時開始摘要（50–95%）。預設：75%。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当对话占用模型上下文窗口的这一比例时开始摘要（50–95%）。默认：75%。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當對話佔用模型上下文視窗的這個比例時開始摘要（50–95%）。預設：75%。"
          }
        }
      }
    },
