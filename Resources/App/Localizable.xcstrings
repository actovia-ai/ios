    "ios:settings.providers.appliesToComputer" : {
      "comment" : "Footer under the AI provider picker.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies sind die Einstellungen Ihres Computers: Anbieter, Modell, Schlüssel und Adressen, die Sie hier wählen, gelten auch für die Chats auf dem Desktop."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These are your computer's settings: the provider, model, keys and addresses chosen here are what the desktop's chats use too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos son los ajustes de tu ordenador: el proveedor, el modelo, las claves y las direcciones que elijas aquí son también los que usan los chats del escritorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce sont les réglages de votre ordinateur : le fournisseur, le modèle, les clés et les adresses choisis ici sont aussi ceux des conversations sur l'ordinateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste sono le impostazioni del tuo computer: il provider, il modello, le chiavi e gli indirizzi scelti qui sono anche quelli usati dalle chat sul desktop."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはコンピュータ側の設定です。ここで選んだプロバイダー、モデル、キー、アドレスはデスクトップ版のチャットにも使われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터의 설정입니다. 여기서 선택한 제공자, 모델, 키, 주소는 데스크톱 채팅에도 그대로 사용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas são as configurações do seu computador: o provedor, o modelo, as chaves e os endereços escolhidos aqui também são usados pelos chats no desktop."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это настройки вашего компьютера: выбранные здесь провайдер, модель, ключи и адреса используются и в чатах на компьютере."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些是你電腦上的設定：在這裡選擇的供應商、模型、金鑰和地址，也是桌面版聊天所使用的。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些是你电脑上的设置：在这里选择的服务商、模型、密钥和地址，桌面版的聊天也会使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些是你電腦上的設定：在這裡選擇的供應商、模型、金鑰與位址，也是桌面版聊天所使用的。"
          }
        }
      }
    },
    "ios:settings.providers.invalidURL" : {
      "comment" : "Validation error when saving AI provider settings. %@ is a provider name such as OpenAI GPT.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Adresse für %@ ist keine gültige URL. Geben Sie das Schema an, z. B. https://."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The address for %@ isn't a valid URL. Include the scheme, such as https://."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dirección de %@ no es una URL válida. Incluye el esquema, por ejemplo https://."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'adresse de %@ n'est pas une URL valide. Indiquez le schéma, par exemple https://."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'indirizzo per %@ non è un URL valido. Includi lo schema, ad esempio https://."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のアドレスは有効な URL ではありません。https:// のようにスキームを含めてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 주소가 올바른 URL이 아닙니다. https://처럼 스킴을 포함하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O endereço de %@ não é uma URL válida. Inclua o esquema, como https://."
          }
        },
        "ru" : {
