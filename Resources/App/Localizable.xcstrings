          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存する前に、サーバーに接続して設定を読み込んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
