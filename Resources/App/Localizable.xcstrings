    "ios:chat.usedMemories.fixHint" : {
      "comment" : "The used-memories sheet at a reply's foot (iOS wording of chat:usedMemories.fixHint, which says Click): under the entries, how a wrong one gets fixed. Names the per-entry button (chat:usedMemories.wrong).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimmt eine Erinnerung nicht? Tippen Sie auf „Falsch?“ und korrigieren Sie sie im Chat – Actovia aktualisiert sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A memory wrong? Tap Wrong? and fix it in chat — Actovia updates it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Algún recuerdo es incorrecto? Toca «¿Incorrecto?» y corrígelo en el chat: Actovia lo actualizará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un souvenir est erroné ? Touchez « Erroné ? » et corrigez-le dans le chat — Actovia le met à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una memoria è sbagliata? Tocca «Sbagliata?» e correggila in chat: Actovia la aggiorna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記憶が違っていたら、「違う？」をタップしてチャットで修正してください。Actovia が記憶を更新します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기억이 틀렸나요? '틀렸나요?'를 탭해 채팅에서 고치면 Actovia가 기억을 업데이트합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguma memória errada? Toque em “Errado?” e corrija no chat — o Actovia a atualiza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись памяти неверна? Нажмите «Неверно?» и исправьте её в чате — Actovia обновит её."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記憶有誤？點「有誤」在對話中修正，Actovia 會更新這條記憶。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记忆有误？轻点“有误？”，在对话中修正——Actovia 会更新它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記憶有誤？點「有誤」在對話中修正，Actovia 會更新這條記憶。"
          }
        }
      }
    },
