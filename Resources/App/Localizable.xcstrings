    "ios:health.onboarding.consentBody" : {
      "comment" : "Health onboarding, step 2 body.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden Tag geht eine Zusammenfassung deiner Werte (nie Rohdaten) an den KI-Anbieter auf deinem Computer, der daraus eine kurze Notiz schreibt. Du kannst das jederzeit ausschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each day, a summary of your numbers (never raw data) goes to the AI provider set up on your computer to write a short note. You can turn this off any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada día, un resumen de tus datos (nunca los datos en bruto) va al proveedor de IA configurado en tu ordenador para escribir una nota breve. Puedes desactivarlo cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque jour, un résumé de tes chiffres (jamais les données brutes) est envoyé au fournisseur d'IA configuré sur ton ordinateur pour écrire une courte note. Tu peux désactiver ça à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni giorno un riepilogo dei tuoi numeri (mai i dati grezzi) va al provider di IA configurato sul tuo computer per scrivere una breve nota. Puoi disattivarlo quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日、数値の要約（生データは送りません）をコンピュータに設定した AI プロバイダーに送り、短いメモを書いてもらいます。いつでもオフにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일 수치 요약(원본 데이터는 절대 아님)을 컴퓨터에 설정된 AI 제공자에게 보내 짧은 노트를 써요. 언제든 끌 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo dia, um resumo dos seus números (nunca os dados brutos) vai para o provedor de IA configurado no seu computador para escrever uma nota curta. Você pode desativar quando quiser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый день сводка ваших показателей (никогда не исходные данные) отправляется AI-провайдеру, настроенному на компьютере, чтобы написать короткую заметку. Это можно отключить в любой момент."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每日會將數據摘要（一定唔包原始資料）傳畀你部電腦上設定嘅 AI 供應商，寫成一段簡短小記。你隨時都可以閂咗佢。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天，你的数据摘要（绝不含原始数据）会发送给你电脑上设置的 AI 服务商，用来写一段简短小记。你可以随时关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天會把數據摘要（絕不含原始資料）傳給你電腦上設定的 AI 供應商，寫成一段簡短小記。你隨時可以關閉。"
          }
        }
      }
    },
