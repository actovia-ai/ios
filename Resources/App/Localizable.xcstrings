    "settings:memory.settings.lcmEnabled.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird ein Chat länger, als das Modell auf einmal lesen kann, wird sein älterer Teil zusammengefasst statt verworfen. Nichts wird gelöscht: Der Assistent kann die Originalnachrichten weiterhin nachschlagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a chat outgrows what the model can read at once, its older part is summarized instead of dropped. Nothing is deleted: the assistant can still look up the original messages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando un chat supera lo que el modelo puede leer de una vez, su parte más antigua se resume en lugar de descartarse. No se borra nada: el asistente puede consultar los mensajes originales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand une conversation dépasse ce que le modèle peut lire d’un coup, sa partie la plus ancienne est résumée au lieu d’être abandonnée. Rien n’est supprimé : l’assistant peut toujours consulter les messages d’origine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando una chat supera ciò che il modello può leggere in una volta, la parte più vecchia viene riassunta invece di essere scartata. Non si perde nulla: l’assistente può ancora consultare i messaggi originali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャットがモデルの一度に読める量を超えると、古い部分は捨てずに要約されます。何も削除されず、アシスタントは元のメッセージを引き続き参照できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채팅이 모델이 한 번에 읽을 수 있는 양을 넘으면 오래된 부분을 버리지 않고 요약합니다. 아무것도 삭제되지 않으며 어시스턴트는 원래 메시지를 계속 찾아볼 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando um chat passa do que o modelo consegue ler de uma vez, a parte mais antiga é resumida em vez de descartada. Nada é apagado: o assistente ainda pode consultar as mensagens originais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда чат перерастает то, что модель может прочитать за раз, его старая часть пересказывается кратко, а не отбрасывается. Ничего не удаляется: ассистент по-прежнему может найти исходные сообщения."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當對話超出模型一次能讀取的範圍時，較舊的部分會被摘要而不是捨棄。不會刪除任何內容：助理仍可查閱原始訊息。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当对话超出模型一次能读取的范围时，较早的部分会被摘要而不是丢弃。不会删除任何内容：助手仍可查阅原始消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當對話超出模型一次能讀取的範圍時，較舊的部分會被摘要而不是捨棄。不會刪除任何內容：助理仍可查閱原始訊息。"
          }
        }
      }
    },
