    "ios:chat.sidebar.deleteMessage" : {
      "comment" : "Message of the confirmation before deleting a chat from the sidebar's long-press menu. %@ is the chat's title.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ und alle Nachrichten darin werden gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” and its messages will be deleted. This can’t be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán «%@» y sus mensajes. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » et ses messages seront supprimés. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» e i suoi messaggi verranno eliminati. L’operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」とそのメッセージが削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 및 해당 메시지가 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” e as mensagens dele serão excluídos. Não é possível desfazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чат «%@» и все его сообщения будут удалены. Это действие нельзя отменить."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」及其中的訊息將會被刪除，且無法還原。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”及其中的消息将被删除，且无法撤销。"
          }
        },
        "zh-Hant" : {
