    "philharmonic:chat.groupChat.emptyState.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschreiben Sie, was Sie brauchen. Der PM analysiert, rekrutiert und delegiert an virtuelle Mitarbeiter und meldet sich anschließend hier zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe what you need. The PM will analyze, recruit and delegate to virtual employees, then report back here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describa lo que necesita. El PM analizará, reclutará y delegará a empleados virtuales, y luego le informará aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décrivez ce dont vous avez besoin. Le PM analysera, recrutera et déléguera aux employés virtuels, puis fera un rapport ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descrivi cosa ti serve. Il PM analizzerà, recluterà e delegherà ai dipendenti virtuali, per poi riportare qui l'esito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要なことを説明してください。PMが分析し、仮想従業員を採用・割り当てたうえで、ここに報告します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필요한 것을 설명해 주세요. PM이 분석하고, 가상 직원을 채용해 업무를 위임한 다음 여기로 결과를 보고합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descreva o que você precisa. O PM vai analisar, recrutar e delegar para funcionários virtuais, depois reportar aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опишите, что нужно. PM проанализирует задачу, наберёт виртуальных сотрудников, распределит работу и доложит здесь."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描述你的需求，項目經理將負責分析、招募並指派給虛擬員工，完成後會在此回報。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描述你的需求。项目经理会进行分析、招募并分派给虚拟员工，完成后在这里汇报。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描述你的需求，專案經理將進行分析、招募並指派給虛擬員工，完成後會在此回報。"
          }
        }
      }
    },
