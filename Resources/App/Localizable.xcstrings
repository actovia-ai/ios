    "ios:settings.pairing.cameraDeniedMessage" : {
      "comment" : "Alert message under 'Camera access is off'. Actovia is the app's name.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben Sie Actovia in den Einstellungen den Kamerazugriff oder fügen Sie stattdessen den Kopplungslink ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Actovia to use the camera in Settings, or paste the pairing link instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que Actovia use la cámara en Ajustes o pega el enlace de vinculación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Actovia à utiliser l’appareil photo dans les Réglages, ou collez le lien de jumelage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti a Actovia di usare la fotocamera nelle Impostazioni, oppure incolla il link di abbinamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」で Actovia にカメラの使用を許可するか、代わりにペアリングリンクをペーストしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 Actovia의 카메라 사용을 허용하거나, 대신 페어링 링크를 붙여넣으세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que o Actovia use a câmera nos Ajustes ou cole o link de pareamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите Actovia использовать камеру в Настройках или вставьте ссылку для сопряжения."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「設定」中允許 Actovia 使用相機，或改為貼上配對連結。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置”中允许 Actovia 使用相机，或改为粘贴配对链接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「設定」中允許 Actovia 使用相機，或改為貼上配對連結。"
          }
        }
      }
    },
