    "ios:onboarding.message" : {
      "comment" : "Under the title of the first screen of an unpaired iPhone; the pairing steps follow.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actovia läuft auf Ihrem Computer: Chats, Erinnerungen und Werkzeuge liegen dort. Koppeln Sie dieses iPhone einmal, dann greift es darauf zu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actovia runs on your computer: your chats, memory and tools live there. Pair this iPhone once and it becomes a window onto it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actovia se ejecuta en tu ordenador: tus chats, tu memoria y tus herramientas están allí. Vincula este iPhone una vez y tendrá acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actovia tourne sur votre ordinateur : vos conversations, votre mémoire et vos outils s’y trouvent. Associez cet iPhone une fois et il y aura accès."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actovia gira sul tuo computer: chat, memoria e strumenti sono lì. Abbina questo iPhone una volta e potrà accedervi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actovia はコンピュータ上で動きます。会話、メモリ、ツールはすべてそこにあります。この iPhone を一度ペアリングすれば、いつでもつながります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actovia는 컴퓨터에서 실행되며 대화, 메모리, 도구가 모두 그곳에 있습니다. 이 iPhone을 한 번 페어링하면 언제든 연결됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Actovia roda no seu computador: suas conversas, memória e ferramentas ficam lá. Pareie este iPhone uma vez e ele terá acesso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actovia работает на вашем компьютере: там хранятся ваши чаты, память и инструменты. Сопрягите этот iPhone один раз — и он станет окном в него."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actovia 在你的電腦上運行：對話、記憶和工具都在那裡。將這部 iPhone 配對一次，它就能隨時連上。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actovia 运行在你的电脑上：你的聊天、记忆和工具都在那里。将这台 iPhone 配对一次，它就成了通往电脑的窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actovia 在你的電腦上執行：對話、記憶和工具都在那裡。將這支 iPhone 配對一次，它就能隨時連上。"
          }
        }
      }
    },
    "ios:onboarding.noActoviaYet" : {
      "comment" : "Under the website link on the welcome screen of an unpaired iPhone.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actovia ist noch nicht auf Ihrem Computer? Installieren Sie es von actovia.yancey.app und koppeln Sie dieses iPhone dann in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don’t have Actovia on your computer yet? Install it from actovia.yancey.app, then pair this iPhone from its Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Aún no tienes Actovia en tu ordenador? Instálalo desde actovia.yancey.app y vincula este iPhone desde sus ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actovia n’est pas encore sur votre ordinateur ? Installez-le depuis actovia.yancey.app, puis associez cet iPhone depuis ses réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai ancora Actovia sul computer? Installalo da actovia.yancey.app, poi abbina questo iPhone dalle sue impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータにまだ Actovia がありませんか？actovia.yancey.app からインストールし、その設定からこの iPhone をペアリングしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터에 아직 Actovia가 없나요? actovia.yancey.app에서 설치한 뒤 설정에서 이 iPhone을 페어링하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não tem o Actovia no computador? Instale em actovia.yancey.app e depois pareie este iPhone nas configurações dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На компьютере ещё нет Actovia? Установите её с actovia.yancey.app, затем сопрягите этот iPhone в её настройках."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電腦上還沒有 Actovia？到 actovia.yancey.app 安裝，再從它的設定配對這部 iPhone。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
