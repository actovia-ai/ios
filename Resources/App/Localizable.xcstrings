        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A personalidade fica salva no seu computador e se aplica a todos os chats, neste celular e no desktop."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Характер сохраняется на компьютере и влияет на каждый чат — и на этом телефоне, и на компьютере."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個人風格儲存在你的電腦上，會影響每一段聊天，無論是在這部手機還是桌面版。"
