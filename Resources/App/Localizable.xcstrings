    "settings:tools.registry.updateMemory.description" : {
      "comment" : "Description of the Update Memory built-in tool in Settings.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaubt dem Assistenten, Gedächtniseinträge zu korrigieren, hinzuzufügen oder zu entfernen, wenn Sie ihm sagen, dass etwas über Sie nicht stimmt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets the assistant correct, add or remove memories when you tell it something about you is wrong."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que el asistente corrija, agregue o elimine entradas de memoria cuando le diga que algo sobre usted es incorrecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à l'assistant de corriger, d'ajouter ou de supprimer des mémoires lorsque vous lui indiquez qu'une information à votre sujet est inexacte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consente all'assistente di correggere, aggiungere o rimuovere voci di memoria quando gli dici che qualcosa su di te è sbagliato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたについての情報が間違っていると伝えると、アシスタントがメモリーを訂正・追加・削除できるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신에 대해 잘못 알고 있는 점을 알려주면 어시스턴트가 메모리를 수정, 추가 또는 삭제할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que o assistente corrija, adicione ou remova memórias quando você disser que algo sobre você está errado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволяет ассистенту исправлять, добавлять или удалять воспоминания, когда вы говорите, что что-то о вас указано неверно."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當你告訴助理你的某些資訊有誤時，助理可以修正、新增或刪除記憶。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你告诉助手关于你的某些信息有误时，助手可以修正、添加或删除记忆。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當你告訴助理你的某些資訊有誤時，助理可以修正、新增或刪除記憶。"
          }
        }
      }
