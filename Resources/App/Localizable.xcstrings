    "settings:memory.settings.freshTailSize.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele deiner neuesten Nachrichten, jeweils mit der ganzen Antwort darauf, immer unverändert gesendet und nie zusammengefasst werden (2–24). Standard: 6."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How many of your latest messages, each with the whole answer to it, are always sent as they are and never summarized (2–24). Default: 6."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuántos de tus mensajes más recientes, cada uno con su respuesta completa, se envían siempre tal cual y nunca se resumen (2–24). Predeterminado: 6."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combien de vos derniers messages, chacun avec sa réponse complète, sont toujours envoyés tels quels et jamais résumés (2–24). Par défaut : 6."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanti dei tuoi messaggi più recenti, ciascuno con la sua risposta completa, vengono sempre inviati così come sono e mai riassunti (2–24). Predefinito: 6."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最新のメッセージのうち、それぞれへの回答全体を含めて、常にそのまま送信し要約しない数（2〜24）。既定値：6。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 메시지 중 각각에 대한 전체 답변과 함께 항상 그대로 보내고 요약하지 않을 개수(2–24). 기본값: 6."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quantas das suas mensagens mais recentes, cada uma com a resposta completa, são sempre enviadas como estão e nunca resumidas (2–24). Padrão: 6."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько ваших последних сообщений вместе с полными ответами на них всегда отправляются как есть и никогда не сжимаются (2–24). По умолчанию: 6."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你最近的多少則訊息（連同各自的完整回答）一律原樣傳送、永不摘要（2–24）。預設：6。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你最近的多少条消息（连同各自的完整回答）始终原样发送、从不摘要（2–24）。默认：6。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你最近的多少則訊息（連同各自的完整回答）一律原樣傳送、永不摘要（2–24）。預設：6。"
          }
        }
      }
    },
