    "ios:settings.tools.configureOnComputer" : {
      "comment" : "Footer on the Built-in Tools settings page.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlüssel und Optionen für die Tools, die sie brauchen, richten Sie unter „Integrierte Tools“ auf Ihrem Computer ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keys and options for the tools that need them are set up in Built-in Tools on your computer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves y opciones de las herramientas que las necesitan se configuran en Herramientas integradas, en tu ordenador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés et options des outils qui en ont besoin se règlent dans Outils intégrés, sur votre ordinateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiavi e opzioni degli strumenti che le richiedono si impostano in Strumenti integrati, sul tuo computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーやオプションが必要なツールは、コンピュータの「組み込みツール」で設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키나 옵션이 필요한 도구는 컴퓨터의 내장 도구에서 설정합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaves e opções das ferramentas que precisam delas são configuradas em Ferramentas Integradas, no seu computador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключи и параметры для инструментов, которым они нужны, настраиваются в разделе «Встроенные инструменты» на компьютере."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要金鑰或有選項的工具，請在電腦上的「內建工具」中設定。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要密钥或选项的工具，请在电脑上的“内置工具”中设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要金鑰或有選項的工具，請在電腦上的「內建工具」中設定。"
          }
        }
      }
    },
    "ios:settings.tools.intro" : {
      "comment" : "Intro at the top of the Built-in Tools settings page.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was das Modell von sich aus aufrufen darf. Schalten Sie ein Tool aus, um es aus allen Chats herauszuhalten, auf diesem Telefon und auf dem Computer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What the model may call on its own. Turn a tool off to keep it out of every chat, on this phone and on the computer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que el modelo puede usar por su cuenta. Desactiva una herramienta para que no se use en ningún chat, ni en este teléfono ni en el ordenador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que le modèle peut appeler de lui-même. Désactivez un outil pour l'exclure de toutes les conversations, sur ce téléphone comme sur l'ordinateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che il modello può usare di sua iniziativa. Disattiva uno strumento per escluderlo da tutte le chat, su questo telefono e sul computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルが自分の判断で呼び出せるツールです。オフにしたツールは、このスマートフォンでもコンピュータでも、どのチャットでも使われません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델이 스스로 호출할 수 있는 도구입니다. 도구를 끄면 이 휴대폰과 컴퓨터의 모든 채팅에서 사용되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que o modelo pode usar por conta própria. Desative uma ferramenta para mantê-la fora de todos os chats, neste celular e no computador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инструменты, которые модель может вызывать сама. Выключите инструмент, чтобы он не использовался ни в одном чате — ни на этом телефоне, ни на компьютере."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型可以自行調用的工具。關閉某個工具後，所有聊天都不會使用它，無論是在這部手機還是電腦上。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型可以自行调用的工具。关闭某个工具后，所有聊天都不会再使用它，无论是在这台手机上还是在电脑上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型可以自行呼叫的工具。關閉某個工具後，所有聊天都不會使用它，無論是在這支手機還是電腦上。"
          }
        }
      }
    },
    "ios:settings.tools.unknownFooter" : {
      "comment" : "Footer under the list of unknown tool names on the Built-in Tools page.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Computer hat Tools ausgeschaltet, die diese App-Version nicht kennt. Sie bleiben aus; aktualisieren Sie die App, um sie hier zu schalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your computer has switched off tools this version of the app doesn't know. They stay off; update the app to switch them here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ordenador ha desactivado herramientas que esta versión de la app no conoce. Siguen desactivadas; actualiza la app para gestionarlas aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre ordinateur a désactivé des outils que cette version de l'app ne connaît pas. Ils restent désactivés ; mettez l'app à jour pour les gérer ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo computer ha disattivato strumenti che questa versione dell'app non conosce. Restano disattivati; aggiorna l'app per gestirli qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバージョンのアプリが認識できないツールがコンピュータでオフになっています。オフのまま維持されます。ここで切り替えるにはアプリをアップデートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터에서 이 버전의 앱이 모르는 도구가 꺼져 있습니다. 꺼진 상태로 유지되며, 여기서 전환하려면 앱을 업데이트하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu computador desativou ferramentas que esta versão do app não conhece. Elas continuam desativadas; atualize o app para alterná-las aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На компьютере выключены инструменты, неизвестные этой версии приложения. Они остаются выключенными; обновите приложение, чтобы управлять ими здесь."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的電腦關閉了這個版本的 App 還未認得的工具。它們會保持關閉；更新 App 後便可在這裡切換。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的电脑关闭了一些此版本 App 无法识别的工具。它们会保持关闭；更新 App 后即可在这里切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的電腦關閉了這個版本的 App 還不認得的工具。它們會維持關閉；更新 App 後即可在這裡切換。"
          }
        }
      }
    },
