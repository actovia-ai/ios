    "ios:health.archive.confirmMessage" : {
      "comment" : "Confirmation message before deleting every kept daily note and period report.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit werden alle auf diesem iPhone gespeicherten Tagesnotizen und Berichte gelöscht. Die heutige Notiz und deine Gesundheitsdaten bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This deletes every daily note and report kept on this iPhone. Today's note and your health data stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todas las notas diarias y los informes guardados en este iPhone. La nota de hoy y tus datos de salud se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les notes quotidiennes et tous les bilans conservés sur cet iPhone seront supprimés. La note du jour et tes données de santé restent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno eliminati tutte le note giornaliere e i resoconti conservati su questo iPhone. La nota di oggi e i tuoi dati sulla salute restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneに保存されている毎日のメモとレポートがすべて削除されます。今日のメモとヘルスケアのデータはそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone에 보관된 모든 일일 노트와 리포트가 삭제돼요. 오늘의 노트와 건강 데이터는 그대로 남아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso apaga todas as notas diárias e relatórios guardados neste iPhone. A nota de hoje e seus dados de saúde continuam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будут удалены все ежедневные заметки и отчёты, сохранённые на этом iPhone. Сегодняшняя заметка и ваши данные о здоровье останутся."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "咁會刪除呢部 iPhone 上面保存嘅所有每日小記同報告。今日嘅小記同你嘅健康資料會保留。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会删除这台 iPhone 上保存的所有每日小记和报告。今天的小记和你的健康数据会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會刪除這部 iPhone 上保存的所有每日小記和報告。今天的小記和你的健康資料都會保留。"
          }
        }
      }
    },
