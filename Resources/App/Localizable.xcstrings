    "ios:settings.providers.keyReentry" : {
      "comment" : "Under the API key field when the computer refused to send the saved key to a new base URL.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der gespeicherte Schlüssel funktioniert nur mit der Adresse, für die er gespeichert wurde. Geben Sie den Schlüssel erneut ein, um diese Adresse zu verwenden."
