    "ios:settings.pairing.instructions" : {
      "comment" : "Settings → Computer, shown while unpaired. 'Settings → Devices' and 'Pair a device' are the desktop app's labels.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppeln Sie dieses iPhone mit Actovia auf Ihrem Computer: Öffnen Sie dort Einstellungen → Geräte und wählen Sie „Gerät koppeln“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pair this iPhone with Actovia on your computer: open Settings → Devices there and choose Pair a device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vincula este iPhone con Actovia en tu ordenador: abre allí Ajustes → Dispositivos y elige Vincular un dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumelez cet iPhone avec Actovia sur votre ordinateur : ouvrez-y Réglages → Appareils et choisissez Jumeler un appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbina questo iPhone a Actovia sul tuo computer: apri lì Impostazioni → Dispositivi e scegli Abbina un dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この iPhone をコンピュータの Actovia とペアリングします。コンピュータ側で「設定 → デバイス」を開き、「デバイスをペアリング」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone을 컴퓨터의 Actovia와 페어링하세요. 컴퓨터에서 ‘설정 → 기기’를 열고 ‘기기 페어링’을 선택하면 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pareie este iPhone com o Actovia no seu computador: abra lá Ajustes → Dispositivos e escolha Parear um dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сопрягите этот iPhone с Actovia на компьютере: откройте там «Настройки → Устройства» и выберите «Сопрячь устройство»."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將這部 iPhone 與電腦上的 Actovia 配對：在電腦上開啟「設定 → 裝置」，然後選擇「配對裝置」。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将这台 iPhone 与电脑上的 Actovia 配对：在电脑上打开“设置 → 设备”，然后选择“配对设备”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將這部 iPhone 與電腦上的 Actovia 配對：在電腦上開啟「設定 → 裝置」，然後選擇「配對裝置」。"
          }
        }
      }
    },
