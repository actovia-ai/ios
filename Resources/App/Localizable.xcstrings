    "ios:chat.composer.mcpSheet.description" : {
      "comment" : "Under the MCP tools sheet's title. Settings › MCP Servers is this app's Settings page of that name.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tools der aktiven MCP-Server. Server schalten Sie unter Einstellungen › MCP-Server ein oder aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tools from the MCP servers that are on. Turn servers on or off in Settings › MCP Servers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herramientas de los servidores MCP activos. Activa o desactiva servidores en Ajustes › Servidores MCP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outils des serveurs MCP actifs. Activez ou désactivez des serveurs dans Réglages › Serveurs MCP."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strumenti dei server MCP attivi. Attiva o disattiva i server in Impostazioni › Server MCP."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効なMCPサーバーのツールです。サーバーのオン／オフは「設定」›「MCPサーバー」で切り替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜져 있는 MCP 서버의 도구입니다. 설정 › MCP 서버에서 서버를 켜거나 끌 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferramentas dos servidores MCP ativos. Ative ou desative servidores em Ajustes › Servidores MCP."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инструменты включённых MCP-серверов. Включайте и выключайте серверы в разделе «Настройки» › «MCP-серверы»."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已開啟的 MCP 伺服器所提供的工具。可在「設定」›「MCP 伺服器」中開啟或關閉伺服器。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已开启的 MCP 服务器所提供的工具。可在“设置”›“MCP 服务器”中开启或关闭服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已開啟的 MCP 伺服器所提供的工具。可在「設定」›「MCP 伺服器」中開啟或關閉伺服器。"
          }
        }
      }
    },
