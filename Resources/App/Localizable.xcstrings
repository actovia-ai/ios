    "chat:usedMemories.fixHint" : {
      "comment" : "The used-memories sheet at a reply's foot: under the entries, how a wrong one gets fixed. Names the per-entry button (chat:usedMemories.wrong).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimmt eine Erinnerung nicht? Klicken Sie auf „Falsch?“ und korrigieren Sie sie im Chat – Actovia aktualisiert sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A memory wrong? Click Wrong? and fix it in chat — Actovia updates it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Algún recuerdo es incorrecto? Haz clic en «¿Incorrecto?» y corrígelo en el chat: Actovia lo actualizará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un souvenir est erroné ? Cliquez sur « Erroné ? » et corrigez-le dans le chat — Actovia le met à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una memoria è sbagliata? Fai clic su «Sbagliata?» e correggila in chat: Actovia la aggiorna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記憶が違っていたら、「違う？」をクリックしてチャットで修正してください。Actovia が記憶を更新します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기억이 틀렸나요? '틀렸나요?'를 클릭해 채팅에서 고치면 Actovia가 기억을 업데이트합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguma memória errada? Clique em “Errado?” e corrija no chat — o Actovia a atualiza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что-то запомнено неверно? Нажмите «Неверно?» и исправьте это в чате — Actovia обновит память."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記憶有誤？點擊「有誤」在對話中修正，Actovia 會更新這條記憶。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记忆有误？点击“有误？”在聊天中纠正，Actovia 会更新它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記憶有誤？點擊「有誤」在對話中修正，Actovia 會更新這條記憶。"
          }
        }
      }
    },
