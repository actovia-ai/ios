    "ios:health.onboarding.body" : {
      "comment" : "Health onboarding, step 1 body: what stays on the phone and what may be sent.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Gesundheitsdaten bleiben auf diesem iPhone. Eine kurze tägliche Zusammenfassung geht nur mit deiner Erlaubnis an den KI-Anbieter auf deinem Computer. Deine Fragen können die Zahlen des Tages enthalten – die kannst du entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your health data stays on this iPhone. A short daily summary goes to the AI provider set up on your computer only if you allow it. Questions you ask can include the day's numbers, which you can remove."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos de salud se quedan en este iPhone. Solo si lo permites se envía un breve resumen diario al proveedor de IA configurado en tu ordenador. Tus preguntas pueden incluir las cifras del día, que puedes quitar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes données de santé restent sur cet iPhone. Un court résumé quotidien n'est envoyé au fournisseur d'IA configuré sur ton ordinateur que si tu l'autorises. Tes questions peuvent inclure les chiffres du jour, que tu peux retirer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati sulla salute restano su questo iPhone. Un breve riepilogo giornaliero va al fornitore di IA configurato sul tuo computer solo se lo permetti. Le tue domande possono includere i numeri del giorno, che puoi togliere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルスケアデータはこの iPhone に残ります。許可した場合のみ、毎日の短い要約をコンピュータで設定した AI プロバイダに送ります。質問にはその日の数値を添付できます（外すこともできます）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "건강 데이터는 이 iPhone에 남아요. 허용한 경우에만 하루 한 번 짧은 요약을 컴퓨터에 설정된 AI 제공업체로 보내요. 질문에는 그날의 수치를 첨부할 수 있고, 뺄 수도 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus dados de saúde ficam neste iPhone. Um resumo diário curto só vai para o provedor de IA configurado no seu computador se você permitir. Suas perguntas podem incluir os números do dia, que você pode remover."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши данные о здоровье остаются на этом iPhone. Краткая сводка за день отправляется AI-провайдеру, настроенному на компьютере, только с вашего разрешения. В ваши вопросы могут входить показатели за день — их можно убрать."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你嘅健康資料會留喺呢部 iPhone。要你允許，先會將每日一份簡短摘要傳去你電腦設定好嘅 AI 供應商。你問嘅問題可以附上當日嘅數字，亦都可以剔走。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的健康数据会保留在这台 iPhone 上。只有在你允许时，每日一份简短摘要才会发送给你电脑上设置的 AI 服务商。你提出的问题可以附上当天的数据，你也可以移除它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的健康資料會留在這部 iPhone 上。只有在你允許時，才會把每日一份簡短摘要傳給你電腦上設定的 AI 供應商。你提出的問題可以附上當天的數字，也可以移除。"
          }
        }
      }
    },
