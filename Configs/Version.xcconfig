// The app's version, shared by every target — the App Store wants the widget
// extension's to match the app's, so it lives here once, not per target.
//
//   MARKETING_VERSION        the manually chosen App Store release version
//   CURRENT_PROJECT_VERSION  a build counter, increased for a new distribution
//
// Run `scripts/set-version.sh <major.minor.patch>` when preparing a distribution.
// It sets the release version and increases the build number. Development commits
// and CI checks never change either value automatically.
MARKETING_VERSION = 1.1.0
CURRENT_PROJECT_VERSION = 453
